{
  "manifest_version": 2,
  "name": "Voice Meet",
  "version": "0.2.4",
  "description": "Запис звуку, локальний Whisper та відповіді з вибраного Gemini або Claude.",
  "browser_specific_settings": {
    "gecko": {
      "id": "voice-meet@ceooffameindustry.local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Meet Voice",
    "default_popup": "popup.html"
  }
}
