{
  "manifest_version": 2,
  "name": "Meet Voice — Gemini / Claude",
  "version": "0.2.0",
  "description": "Запис звуку, локальний Whisper та відповіді з вибраного Gemini або Claude.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meet-voice@local.invalid",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Meet Voice",
    "default_popup": "popup.html"
  }
}
